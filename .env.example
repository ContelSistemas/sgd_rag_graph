# Graph RAG para Base del Conocimiento - Ejemplo de configuración
# Copia este archivo a .env y ajusta los valores según tu entorno

# LLM
LLM_BACKEND=llamacpp
LLM_BASE_URL=http://localhost:8080
LLM_MODEL_NAME=llama3
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_BASE_DELAY=1.0

# Vector Store
VECTOR_STORE_DIR=data/vectorstore
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Graph
GRAPH_PERSIST_PATH=data/knowledge_graph.json

# Data
DATA_DIR=data

# API
API_HOST=0.0.0.0
API_PORT=8000
API_MAX_TIMEOUT=600

# Retrieval defaults
DEFAULT_TOP_K=20
DEFAULT_GRAPH_RADIUS=1
